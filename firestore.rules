rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /profiles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'full_name',
          'email',
          'phone',
          'role',
          'created_at',
          'updated_at'
        ])
        && request.resource.data.full_name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.role == 'pending';

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'phone', 'updated_at'])
        && request.resource.data.full_name is string
        && request.resource.data.phone is string;

      allow delete: if false;
    }

    match /system/{documentId} {
      allow read, write: if false;
    }
  }
}
